NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# JWT Auth
JWT_EXPIRATION=7d
# Enforced security check: must be at least 32 characters long
JWT_SECRET=YOUR_SECURE_JWT_SECRET_MUST_BE_AT_LEAST_32_CHARS_LONG

# Google Sign-In — OAuth 2.0 Client IDs from https://console.cloud.google.com/apis/credentials
# Accepted `aud` values when verifying an ID token.
#
# WEB is the one that matters for Android: the native SDK signs in with the web
# client ID, so Android tokens carry it as their `aud`. IOS is needed for iOS
# builds. ANDROID is never an `aud` in this flow — it only has to be registered
# in the Google console against the package name and signing SHA-1 — so leaving
# it blank here is fine.
#
# With all three blank, POST /api/auth/google returns 401.
GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# AI Integrations
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=your-openai-api-key

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
