{
  "expo": {
    "name": "Upcheck Dairy",
    "slug": "upcheck-dairy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "upcheckdairy",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16a34a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.upcheckdairy.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Upcheck Dairy needs camera access to take photos of your animals and scan ear tags",
        "NSMicrophoneUsageDescription": "Upcheck Dairy needs microphone access for voice commands",
        "NSPhotoLibraryUsageDescription": "Upcheck Dairy needs photo library access to select animal photos",
        "NSLocationWhenInUseUsageDescription": "Upcheck Dairy uses your location for local weather information",
        "NSSpeechRecognitionUsageDescription": "Upcheck Dairy uses speech recognition for voice commands",
        "NSFaceIDUsageDescription": "Upcheck Dairy uses Face ID to securely authenticate you"
      }
    },
    "android": {
      "package": "com.upcheckdairy.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#16a34a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Feather.ttf"
          ]
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Upcheck Dairy needs access to your photos to add animal pictures",
          "cameraPermission": "Upcheck Dairy needs camera access to take photos of your animals"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Upcheck Dairy needs camera access to scan animal ear tags and take photos",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#16a34a",
          "sounds": []
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Upcheck Dairy needs microphone access for voice commands"
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "ed0a2399-efb6-4502-81a2-663295c53151"
      },
      "router": {}
    },
    "owner": "upcheck"
  }
}
