# Backend API base URL (must include the /api prefix)
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Google Sign-In — OAuth 2.0 Client IDs from https://console.cloud.google.com/apis/credentials
#
# These reach the app through app.config.js -> expo.extra. EXPO_PUBLIC_* values
# are inlined at build time, so set them before `expo prebuild` / an EAS build,
# not at runtime. With all three blank the Google button is hidden.
#
# WEB   — required on every platform. Android's native sign-in exchanges the
#         device credential for an ID token whose `aud` is the *web* client ID,
#         so this must be set even for an Android-only build.
# ANDROID — create one per signing key (debug + release/Play App Signing) with
#         package name com.upcheckdairy.app and that key's SHA-1. It is never
#         referenced in app code, but sign-in fails without it registered.
# IOS   — required for iOS builds; bundle identifier com.upcheckdairy.app.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
